    "./presets/reveal": "./presets/reveal/reveal.js",
    "./presets/reveal/css": "./presets/reveal/reveal.css",
    "./presets/spark": "./presets/spark/spark.js",
    "./presets/smoke": "./presets/smoke/smoke.js",
    "./presets/line-wave": "./presets/line-wave/line-wave.js",
    "./presets/line-wave/css": "./presets/line-wave/line-wave.css"
  },
  "publishConfig": {
