    "./behaviours/origin/edge": "./behaviours/origin/edge.js",
    "./behaviours/motion/ballistic": "./behaviours/motion/ballistic.js",
    "./behaviours/motion/curl": "./behaviours/motion/curl.js",
    "./behaviours/render/dot": "./behaviours/render/dot.js",
    "./behaviours/render/puff": "./behaviours/render/puff.js",
    "./behaviours/render/segment": "./behaviours/render/segment.js",
    "./presets/trail": "./presets/trail/trail.js",
    "./presets/click-burst": "./presets/click-burst/click-burst.js",
    "./presets/electric": "./presets/electric/electric.js",
    "./presets/magnetic": "./presets/magnetic/magnetic.js",
    "./presets/magnetic/css": "./presets/magnetic/magnetic.css",
    "./presets/hover-flicker": "./presets/hover-flicker/hover-flicker.js",
