{
  "compilerOptions": {
    "target": "ES2017",
    "module": "None",
    "ignoreDeprecations": "6.0",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outFile": "../chart.js",
    "rootDir": "./src",
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules"]
}
